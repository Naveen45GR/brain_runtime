{
  "format": "gr-brain-platform/1",
  "adapter": {
    "version": 1,
    "hz": [
      5,
      10,
      25,
      50
    ],
    "control_dt": 0.02,
    "max_chunk": 50,
    "safety_max_deg_per_sec": [
      1,
      720
    ]
  },
  "model_run_seconds": 10,
  "model_criteria": [
    {
      "measure": "hard_violations",
      "op": "==",
      "value": 0,
      "why": "A brain must never break a hard limit of the robot."
    },
    {
      "measure": "worst_torque_pct",
      "op": "<",
      "value": 100,
      "why": "No actuator may be asked for more torque than it has."
    }
  ],
  "task_criterion": {
    "measure": "task.success",
    "op": "==",
    "value": 1,
    "why": "The task is judged from where things end up."
  },
  "verify": {
    "max_seeds": 10,
    "max_sim_seconds": 120
  },
